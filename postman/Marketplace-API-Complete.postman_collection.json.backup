{
    "info": {
        "_postman_id": "marketplace-api-complete-6966c88f4114a",
        "name": "Marketplace Nigeria API - Complete",
        "description": "Complete API collection for Marketplace Nigeria with sample data\n\n**Base URLs:**\n- Local: http://127.0.0.1:8030\n- Production: https://www.marketplace.ng\n\n**Authentication:**\nMost endpoints require Bearer token. Login first to get your token.\n\n**All requests include sample data - ready to test!**\n\n**Version:** 3.0\n**Generated:** 2026-01-21 (Updated Routes)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "3.1"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{auth_token}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Auto-save auth token from login",
                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        ",
                    "        // Save token from login/register",
                    "        if (response.data && response.data.token) {",
                    "            pm.environment.set(\"auth_token\", response.data.token);",
                    "            console.log(\"✅ Auth token saved to environment\");",
                    "        }",
                    "        ",
                    "        // Save user_id",
                    "        if (response.data && response.data.user_id) {",
                    "            pm.environment.set(\"user_id\", response.data.user_id);",
                    "            console.log(\"✅ User ID saved:\", response.data.user_id);",
                    "        }",
                    "        ",
                    "        // Save advert_id from create advert",
                    "        if (response.data && response.data.id && pm.request.url.path.includes(\"adverts\")) {",
                    "            pm.environment.set(\"advert_id\", response.data.id);",
                    "            console.log(\"✅ Advert ID saved:\", response.data.id);",
                    "        }",
                    "    } catch (e) {",
                    "        // Ignore JSON parse errors",
                    "    }",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "01. Authentication",
