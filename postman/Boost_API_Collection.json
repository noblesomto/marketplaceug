{
  "info": {
    "name": "Marketplace Nigeria - Boost API",
    "description": "API collection for dynamic boost pricing system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "marketplace-boost-api"
  },
  "item": [
    {
      "name": "Get Boost Options",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success field\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response has boost_types and durations\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('boost_types');",
              "    pm.expect(jsonData.data).to.have.property('durations');",
              "    pm.expect(jsonData.data.boost_types).to.be.an('array');",
              "    pm.expect(jsonData.data.durations).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Boost types have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data.boost_types.length > 0) {",
              "        var boostType = jsonData.data.boost_types[0];",
              "        pm.expect(boostType).to.have.property('id');",
              "        pm.expect(boostType).to.have.property('name');",
              "        pm.expect(boostType).to.have.property('daily_rate');",
              "        pm.expect(boostType).to.have.property('display_order');",
              "    }",
              "});",
              "",
              "pm.test(\"Durations have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data.durations.length > 0) {",
              "        var duration = jsonData.data.durations[0];",
              "        pm.expect(duration).to.have.property('id');",
              "        pm.expect(duration).to.have.property('days');",
              "        pm.expect(duration).to.have.property('discount_percentage');",
              "        pm.expect(duration).to.have.property('label');",
              "    }",
              "});",
              "",
              "// Save first boost type and duration IDs for use in other requests",
              "var jsonData = pm.response.json();",
              "if (jsonData.data.boost_types.length > 0) {",
              "    pm.environment.set(\"boost_type_id\", jsonData.data.boost_types[0].id);",
              "}",
              "if (jsonData.data.durations.length > 0) {",
              "    pm.environment.set(\"duration_id\", jsonData.data.durations[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/boost/options",
          "host": ["{{base_url}}"],
          "path": ["api", "boost", "options"]
        },
        "description": "Retrieves all active boost types and durations available for selection."
      },
      "response": []
    },
    {
      "name": "Calculate Boost Price - Valid Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success field\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response has all required data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('boost_type');",
              "    pm.expect(jsonData.data).to.have.property('duration');",
              "    pm.expect(jsonData.data).to.have.property('pricing');",
              "});",
              "",
              "pm.test(\"Pricing has all required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    var pricing = jsonData.data.pricing;",
              "    pm.expect(pricing).to.have.property('base_price');",
              "    pm.expect(pricing).to.have.property('discount_percentage');",
              "    pm.expect(pricing).to.have.property('discount_amount');",
              "    pm.expect(pricing).to.have.property('final_price');",
              "    pm.expect(pricing).to.have.property('currency');",
              "    pm.expect(pricing.currency).to.equal('NGN');",
              "});",
              "",
              "pm.test(\"Pricing calculation is correct\", function () {",
              "    var jsonData = pm.response.json();",
              "    var pricing = jsonData.data.pricing;",
              "    var basePrice = parseFloat(pricing.base_price);",
              "    var discountAmount = parseFloat(pricing.discount_amount);",
              "    var finalPrice = parseFloat(pricing.final_price);",
              "    pm.expect(finalPrice).to.equal(basePrice - discountAmount);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"boost_type_id\": {{boost_type_id}},\n  \"duration_id\": {{duration_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/boost/calculate",
          "host": ["{{base_url}}"],
          "path": ["api", "boost", "calculate"]
        },
        "description": "Calculates the price for a boost based on selected type and duration with discounts applied."
      },
      "response": []
    },
